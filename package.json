{
  "name": "biome-turbo-strapi-next-rtk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "pnpm run types",
    "dev": "turbo run dev",
    "types": "pnpm --filter backend run types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
