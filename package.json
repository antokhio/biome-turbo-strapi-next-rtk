{
  "name": "biome-turbo-strapi-next-rtk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "pnpm run types",
    "dev": "turbo run dev",
    "types": "pnpm --filter backend run types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=18"
  }
}
